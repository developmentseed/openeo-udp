{
  "process_graph": {
    "loadcollection1": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "B03",
          "B04",
          "B11",
          "SCL"
        ],
        "id": "SENTINEL2_L2A",
        "properties": {
          "eo:cloud_cover": {
            "process_graph": {
              "lte1": {
                "process_id": "lte",
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": {
                    "from_parameter": "cloud_cover"
                  }
                },
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "from_parameter": "bounding_box"
        },
        "temporal_extent": {
          "from_parameter": "time"
        }
      }
    },
    "resamplespatial1": {
      "process_id": "resample_spatial",
      "arguments": {
        "align": "upper-left",
        "data": {
          "from_node": "loadcollection1"
        },
        "method": "near",
        "projection": null,
        "resolution": 20
      }
    },
    "reducedimension1": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "resamplespatial1"
        },
        "dimension": "bands",
        "reducer": {
          "process_graph": {
            "arrayelement1": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 0
              }
            },
            "divide1": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "arrayelement1"
                },
                "y": 10000.0
              }
            },
            "arrayelement2": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 2
              }
            },
            "divide2": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": 10000.0
              }
            },
            "subtract1": {
              "process_id": "subtract",
              "arguments": {
                "x": {
                  "from_node": "divide1"
                },
                "y": {
                  "from_node": "divide2"
                }
              }
            },
            "add1": {
              "process_id": "add",
              "arguments": {
                "x": {
                  "from_node": "divide1"
                },
                "y": {
                  "from_node": "divide2"
                }
              }
            },
            "divide3": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "subtract1"
                },
                "y": {
                  "from_node": "add1"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "apply1": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "reducedimension1"
        },
        "process": {
          "process_graph": {
            "gt1": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "ndsi_pass1"
                }
              }
            },
            "multiply1": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "gt1"
                },
                "y": 1.0
              },
              "result": true
            }
          }
        }
      }
    },
    "reducedimension2": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "resamplespatial1"
        },
        "dimension": "bands",
        "reducer": {
          "process_graph": {
            "arrayelement3": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 1
              }
            },
            "divide4": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "arrayelement3"
                },
                "y": 10000.0
              },
              "result": true
            }
          }
        }
      }
    },
    "apply2": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "reducedimension2"
        },
        "process": {
          "process_graph": {
            "lte2": {
              "process_id": "lte",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "red_pass1"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "mask1": {
      "process_id": "mask",
      "arguments": {
        "data": {
          "from_node": "apply1"
        },
        "mask": {
          "from_node": "apply2"
        },
        "replacement": 0
      }
    },
    "reducedimension3": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "resamplespatial1"
        },
        "dimension": "bands",
        "reducer": {
          "process_graph": {
            "arrayelement4": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 3
              }
            },
            "eq1": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": 2
              }
            },
            "eq2": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": 4
              }
            },
            "or1": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "eq1"
                },
                "y": {
                  "from_node": "eq2"
                }
              }
            },
            "eq3": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": 5
              }
            },
            "or2": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "or1"
                },
                "y": {
                  "from_node": "eq3"
                }
              }
            },
            "eq4": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": 6
              }
            },
            "or3": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "or2"
                },
                "y": {
                  "from_node": "eq4"
                }
              }
            },
            "eq5": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": 7
              }
            },
            "or4": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "or3"
                },
                "y": {
                  "from_node": "eq5"
                }
              }
            },
            "eq6": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": 11
              }
            },
            "or5": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "or4"
                },
                "y": {
                  "from_node": "eq6"
                }
              }
            },
            "if1": {
              "process_id": "if",
              "arguments": {
                "accept": 0,
                "reject": 1,
                "value": {
                  "from_node": "or5"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "mask2": {
      "process_id": "mask",
      "arguments": {
        "data": {
          "from_node": "mask1"
        },
        "mask": {
          "from_node": "reducedimension3"
        }
      }
    },
    "reducedimension4": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "mask2"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "mean1": {
              "process_id": "mean",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "apply3": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "reducedimension1"
        },
        "process": {
          "process_graph": {
            "gt2": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "ndsi_pass2"
                }
              }
            },
            "multiply2": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "gt2"
                },
                "y": 1.0
              },
              "result": true
            }
          }
        }
      }
    },
    "apply4": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "reducedimension2"
        },
        "process": {
          "process_graph": {
            "lte3": {
              "process_id": "lte",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "red_pass2"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "mask3": {
      "process_id": "mask",
      "arguments": {
        "data": {
          "from_node": "apply3"
        },
        "mask": {
          "from_node": "apply4"
        },
        "replacement": 0
      }
    },
    "apply5": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "mask1"
        },
        "process": {
          "process_graph": {
            "gt3": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": 0.5
              },
              "result": true
            }
          }
        }
      }
    },
    "mask4": {
      "process_id": "mask",
      "arguments": {
        "data": {
          "from_node": "mask3"
        },
        "mask": {
          "from_node": "apply5"
        },
        "replacement": 1
      }
    },
    "mask5": {
      "process_id": "mask",
      "arguments": {
        "data": {
          "from_node": "mask4"
        },
        "mask": {
          "from_node": "reducedimension3"
        }
      }
    },
    "reducedimension5": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "mask5"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "mean2": {
              "process_id": "mean",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "mergecubes1": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "reducedimension5"
        },
        "cube2": {
          "from_node": "reducedimension4"
        },
        "overlap_resolver": {
          "process_graph": {
            "subtract2": {
              "process_id": "subtract",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "y"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "loadcollection2": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "DEM"
        ],
        "id": "COPERNICUS_30",
        "spatial_extent": {
          "from_parameter": "bounding_box"
        },
        "temporal_extent": null
      }
    },
    "reducedimension6": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "loadcollection2"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "max1": {
              "process_id": "max",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "apply6": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "reducedimension6"
        },
        "process": {
          "process_graph": {
            "gt4": {
              "process_id": "gt",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "snowline_elevation"
                }
              }
            },
            "multiply3": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "gt4"
                },
                "y": 1.0
              },
              "result": true
            }
          }
        }
      }
    },
    "resamplecubespatial1": {
      "process_id": "resample_cube_spatial",
      "arguments": {
        "data": {
          "from_node": "apply6"
        },
        "method": "near",
        "target": {
          "from_node": "resamplespatial1"
        }
      }
    },
    "reducedimension7": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "resamplecubespatial1"
        },
        "dimension": "bands",
        "reducer": {
          "process_graph": {
            "arrayelement5": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 0
              },
              "result": true
            }
          }
        }
      }
    },
    "mergecubes2": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "mergecubes1"
        },
        "cube2": {
          "from_node": "reducedimension7"
        },
        "overlap_resolver": {
          "process_graph": {
            "multiply4": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "y"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "mergecubes3": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "reducedimension4"
        },
        "cube2": {
          "from_node": "mergecubes2"
        },
        "overlap_resolver": {
          "process_graph": {
            "add2": {
              "process_id": "add",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": {
                  "from_parameter": "y"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "adddimension1": {
      "process_id": "add_dimension",
      "arguments": {
        "data": {
          "from_node": "mergecubes3"
        },
        "label": "snow_cover_fraction",
        "name": "bands",
        "type": "bands"
      }
    },
    "reducedimension8": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "mask2"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "count1": {
              "process_id": "count",
              "arguments": {
                "context": {
                  "from_parameter": "context"
                },
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "adddimension2": {
      "process_id": "add_dimension",
      "arguments": {
        "data": {
          "from_node": "reducedimension8"
        },
        "label": "clear_observations",
        "name": "bands",
        "type": "bands"
      }
    },
    "mergecubes4": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "adddimension1"
        },
        "cube2": {
          "from_node": "adddimension2"
        }
      },
      "result": true
    }
  },
  "parameters": [
    {
      "name": "bounding_box",
      "description": "Spatial extent (N\u00e9ouvielle massif, Hautes-Pyr\u00e9n\u00e9es, France)",
      "schema": {
        "type": "object",
        "subtype": "bounding-box"
      },
      "default": {
        "west": 0.05,
        "south": 42.78,
        "east": 0.3,
        "north": 42.92
      },
      "optional": true
    },
    {
      "name": "time",
      "description": "Temporal range of the Sentinel-2 acquisitions. The snow cover fraction is computed over this range.",
      "schema": {
        "type": "array",
        "subtype": "temporal-interval"
      },
      "default": [
        "2023-01-01",
        "2023-05-31"
      ],
      "optional": true
    },
    {
      "name": "cloud_cover",
      "description": "Maximum scene-level cloud cover (%). Clouds are also masked per pixel with SCL, so this only skips the worst scenes.",
      "schema": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "default": 50,
      "optional": true
    },
    {
      "name": "ndsi_pass1",
      "description": "LIS pass 1 NDSI threshold n1: snow if NDSI > n1 and red > r1",
      "schema": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "default": 0.4,
      "optional": true
    },
    {
      "name": "red_pass1",
      "description": "LIS pass 1 red reflectance threshold r1 (0-1 reflectance)",
      "schema": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "default": 0.2,
      "optional": true
    },
    {
      "name": "ndsi_pass2",
      "description": "LIS pass 2 NDSI threshold n2, applied above the snowline elevation",
      "schema": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "default": 0.15,
      "optional": true
    },
    {
      "name": "red_pass2",
      "description": "LIS pass 2 red reflectance threshold r2 (0-1 reflectance)",
      "schema": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "default": 0.04,
      "optional": true
    },
    {
      "name": "snowline_elevation",
      "description": "Snowline elevation zs in metres. Pass 2 (n2, r2) applies only to pixels above zs. LIS computes zs per image; this simplified version takes one value per run. Set it above the highest summit (for example 9000) to switch pass 2 off.",
      "schema": {
        "type": "number"
      },
      "default": 1100,
      "optional": true
    }
  ],
  "id": "lis_snow_cover",
  "summary": "LIS-like snow cover fraction from Sentinel-2 L2A and the Copernicus DEM with openEO.",
  "description": "Snow cover fraction (number of snow dates divided by the number of clear dates) and number of clear observations from Sentinel-2 L2A, with a simplified version of the CNES/CESBIO Let-it-snow (LIS) algorithm: pass 1 (NDSI > n1 and red > r1), pass 2 above a snowline elevation (NDSI > n2 and red > r2) with the Copernicus DEM GLO-30, and a Sen2Cor SCL cloud and no-data mask. Original implementation inspired by Gascoin et al. (2019), ESSD 11, 493-514."
}
