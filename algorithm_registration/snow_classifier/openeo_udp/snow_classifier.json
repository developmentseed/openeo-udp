      "default": 30,
      "optional": true
    },
    {
      "name": "ndsi_threshold",
      "description": "NDSI value above which a pixel is classified as snow",
      "schema": {
        "type": "number"
      },
      "default": 0.4,
      "optional": true
    },
    {
      "name": "target_resolution",
      "description": "Spatial resolution (meters) to resample to before classification. Defaults to 20m, the coarsest native resolution among the requested bands (B11 SWIR), so no band is upsampled beyond its native resolution.",
      "schema": {
        "type": "number"
      },
      "default": 20,
      "optional": true
    }
