{
  "process_graph": {
    "arrayelement1": {
      "process_id": "array_element",
      "arguments": {
        "data": {
          "from_parameter": "time"
        },
        "index": 1
      }
    },
    "dateshift1": {
      "process_id": "date_shift",
      "arguments": {
        "date": {
          "from_node": "arrayelement1"
        },
        "unit": "month",
        "value": -3
      }
    },
    "loadcollection1": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "B04",
          "B08",
          "SCL"
        ],
        "id": "SENTINEL2_L2A",
        "properties": {
          "eo:cloud_cover": {
            "process_graph": {
              "lte1": {
                "process_id": "lte",
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": 70
                },
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "from_parameter": "bounding_box"
        },
        "temporal_extent": [
          {
            "from_node": "dateshift1"
          },
          {
            "from_node": "arrayelement1"
          }
        ]
      }
    },
    "reducedimension1": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "loadcollection1"
        },
        "dimension": "bands",
        "reducer": {
          "process_graph": {
            "arrayelement2": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 2
              }
            },
            "eq1": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": 3
              }
            },
            "eq2": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": 8
              }
            },
            "or1": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "eq1"
                },
                "y": {
                  "from_node": "eq2"
                }
              }
            },
            "eq3": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": 9
              }
            },
            "or2": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "or1"
                },
                "y": {
                  "from_node": "eq3"
                }
              }
            },
            "eq4": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": 10
              }
            },
            "or3": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "or2"
                },
                "y": {
                  "from_node": "eq4"
                }
              }
            },
            "eq5": {
              "process_id": "eq",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": 11
              }
            },
            "or4": {
              "process_id": "or",
              "arguments": {
                "x": {
                  "from_node": "or3"
                },
                "y": {
                  "from_node": "eq5"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "mask1": {
      "process_id": "mask",
      "arguments": {
        "data": {
          "from_node": "loadcollection1"
        },
        "mask": {
          "from_node": "reducedimension1"
        }
      }
    },
    "reducedimension2": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "mask1"
        },
        "dimension": "bands",
        "reducer": {
          "process_graph": {
            "arrayelement3": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 1
              }
            },
            "divide1": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "arrayelement3"
                },
                "y": 10000.0
              }
            },
            "arrayelement4": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 0
              }
            },
            "divide2": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "arrayelement4"
                },
                "y": 10000.0
              }
            },
            "normalizeddifference1": {
              "process_id": "normalized_difference",
              "arguments": {
                "x": {
                  "from_node": "divide1"
                },
                "y": {
                  "from_node": "divide2"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "dateshift2": {
      "process_id": "date_shift",
      "arguments": {
        "date": {
          "from_node": "arrayelement1"
        },
        "unit": "month",
        "value": -3
      }
    },
    "dateshift3": {
      "process_id": "date_shift",
      "arguments": {
        "date": {
          "from_node": "arrayelement1"
        },
        "unit": "month",
        "value": -2
      }
    },
    "arraycreate1": {
      "process_id": "array_create",
      "arguments": {
        "data": [
          {
            "from_node": "dateshift2"
          },
          {
            "from_node": "dateshift3"
          }
        ]
      }
    },
    "dateshift4": {
      "process_id": "date_shift",
      "arguments": {
        "date": {
          "from_node": "arrayelement1"
        },
        "unit": "month",
        "value": -1
      }
    },
    "arraycreate2": {
      "process_id": "array_create",
      "arguments": {
        "data": [
          {
            "from_node": "dateshift3"
          },
          {
            "from_node": "dateshift4"
          }
        ]
      }
    },
    "arraycreate3": {
      "process_id": "array_create",
      "arguments": {
        "data": [
          {
            "from_node": "dateshift4"
          },
          {
            "from_node": "arrayelement1"
          }
        ]
      }
    },
    "arraycreate4": {
      "process_id": "array_create",
      "arguments": {
        "data": [
          {
            "from_node": "arraycreate1"
          },
          {
            "from_node": "arraycreate2"
          },
          {
            "from_node": "arraycreate3"
          }
        ]
      }
    },
    "arraycreate5": {
      "process_id": "array_create",
      "arguments": {
        "data": [
          {
            "from_node": "dateshift2"
          },
          {
            "from_node": "dateshift3"
          },
          {
            "from_node": "dateshift4"
          }
        ]
      }
    },
    "aggregatetemporal1": {
      "process_id": "aggregate_temporal",
      "arguments": {
        "data": {
          "from_node": "reducedimension2"
        },
        "intervals": {
          "from_node": "arraycreate4"
        },
        "labels": {
          "from_node": "arraycreate5"
        },
        "reducer": {
          "process_graph": {
            "mean1": {
              "process_id": "mean",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "apply1": {
      "process_id": "apply",
      "arguments": {
        "data": {
          "from_node": "aggregatetemporal1"
        },
        "process": {
          "process_graph": {
            "subtract1": {
              "process_id": "subtract",
              "arguments": {
                "x": {
                  "from_parameter": "x"
                },
                "y": 0.1
              }
            },
            "divide3": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "subtract1"
                },
                "y": 0.6
              }
            },
            "clip1": {
              "process_id": "clip",
              "arguments": {
                "max": 1.0,
                "min": 0.0,
                "x": {
                  "from_node": "divide3"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "reducedimension3": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "apply1"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "arrayelement5": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 0
              },
              "result": true
            }
          }
        }
      }
    },
    "adddimension1": {
      "process_id": "add_dimension",
      "arguments": {
        "data": {
          "from_node": "reducedimension3"
        },
        "label": "R",
        "name": "bands",
        "type": "bands"
      }
    },
    "reducedimension4": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "apply1"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "arrayelement6": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 1
              },
              "result": true
            }
          }
        }
      }
    },
    "adddimension2": {
      "process_id": "add_dimension",
      "arguments": {
        "data": {
          "from_node": "reducedimension4"
        },
        "label": "G",
        "name": "bands",
        "type": "bands"
      }
    },
    "mergecubes1": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "adddimension1"
        },
        "cube2": {
          "from_node": "adddimension2"
        }
      }
    },
    "reducedimension5": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "apply1"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "arrayelement7": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 2
              },
              "result": true
            }
          }
        }
      }
    },
    "adddimension3": {
      "process_id": "add_dimension",
      "arguments": {
        "data": {
          "from_node": "reducedimension5"
        },
        "label": "B",
        "name": "bands",
        "type": "bands"
      }
    },
    "mergecubes2": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "mergecubes1"
        },
        "cube2": {
          "from_node": "adddimension3"
        }
      }
    },
    "saveresult1": {
      "process_id": "save_result",
      "arguments": {
        "data": {
          "from_node": "mergecubes2"
        },
        "format": "GTiff",
        "options": {}
      },
      "result": true
    }
  },
  "parameters": [
    {
      "name": "time",
      "description": "Growing-season window; only its end date is used. Data is loaded for, and capped to, the three months before the end date (oldest->R, middle->G, newest->B); any earlier part of the window is ignored",
      "schema": {
        "type": "array",
        "subtype": "temporal-interval"
      },
      "default": [
        "2017-06-01",
        "2017-08-31"
      ],
      "optional": true
    },
    {
      "name": "bounding_box",
      "description": "Spatial extent for Venice and its mainland cropland, Italy",
      "schema": {
        "type": "object",
        "subtype": "bounding-box"
      },
      "default": {
        "west": 12.3215,
        "south": 45.5008,
        "east": 12.4913,
        "north": 45.5726
      },
      "optional": true
    }
  ],
  "id": "agriculture_growth_stage",
  "summary": "Multi-temporal NDVI growth-stage RGB composite from Sentinel-2 imagery using openEO.",
  "description": "Multi-temporal NDVI composite that assigns the mean NDVI of each of three calendar months to the red, green and blue channels, so colour encodes when in the season vegetation peaked and separates crops by growth stage."
}