    },
    "loadcollection2": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "VV"
        ],
        "id": "SENTINEL1_GRD",
        "spatial_extent": {
          "from_parameter": "bounding_box"
        },
        "temporal_extent": {
          "from_parameter": "time_during"
