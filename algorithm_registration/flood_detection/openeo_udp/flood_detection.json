{
  "process_graph": {
    "loadcollection1": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "B08"
        ],
        "id": "SENTINEL2_L2A",
        "properties": {
          "eo:cloud_cover": {
            "process_graph": {
              "lte1": {
                "process_id": "lte",
                "arguments": {
                  "x": {
                    "from_parameter": "value"
                  },
                  "y": 30
                },
                "result": true
              }
            }
          }
        },
        "spatial_extent": {
          "from_parameter": "bounding_box"
        },
        "temporal_extent": {
          "from_parameter": "time"
        }
      }
    },
    "reducedimension1": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "loadcollection1"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "last1": {
              "process_id": "last",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "loadcollection2": {
      "process_id": "load_collection",
      "arguments": {
        "bands": [
          "VV"
        ],
        "id": "SENTINEL1_GRD",
        "spatial_extent": {
          "from_parameter": "bounding_box"
        },
        "temporal_extent": {
          "from_parameter": "time"
        }
      }
    },
    "reducedimension2": {
      "process_id": "reduce_dimension",
      "arguments": {
        "data": {
          "from_node": "loadcollection2"
        },
        "dimension": "t",
        "reducer": {
          "process_graph": {
            "last2": {
              "process_id": "last",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                }
              },
              "result": true
            }
          }
        }
      }
    },
    "resamplecubespatial1": {
      "process_id": "resample_cube_spatial",
      "arguments": {
        "data": {
          "from_node": "reducedimension2"
        },
        "method": "near",
        "target": {
          "from_node": "reducedimension1"
        }
      }
    },
    "mergecubes1": {
      "process_id": "merge_cubes",
      "arguments": {
        "cube1": {
          "from_node": "reducedimension1"
        },
        "cube2": {
          "from_node": "resamplecubespatial1"
        }
      }
    },
    "applydimension1": {
      "process_id": "apply_dimension",
      "arguments": {
        "data": {
          "from_node": "mergecubes1"
        },
        "dimension": "bands",
        "process": {
          "process_graph": {
            "arrayelement1": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 1
              }
            },
            "multiply1": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "arrayelement1"
                },
                "y": 10
              }
            },
            "arrayelement2": {
              "process_id": "array_element",
              "arguments": {
                "data": {
                  "from_parameter": "data"
                },
                "index": 0
              }
            },
            "divide1": {
              "process_id": "divide",
              "arguments": {
                "x": {
                  "from_node": "arrayelement2"
                },
                "y": 10000.0
              }
            },
            "multiply2": {
              "process_id": "multiply",
              "arguments": {
                "x": 2.5,
                "y": {
                  "from_node": "divide1"
                }
              }
            },
            "log1": {
              "process_id": "log",
              "arguments": {
                "base": 10,
                "x": {
                  "from_node": "arrayelement1"
                }
              }
            },
            "multiply3": {
              "process_id": "multiply",
              "arguments": {
                "x": 10,
                "y": {
                  "from_node": "log1"
                }
              }
            },
            "lte2": {
              "process_id": "lte",
              "arguments": {
                "x": {
                  "from_node": "multiply3"
                },
                "y": -15
              }
            },
            "if1": {
              "process_id": "if",
              "arguments": {
                "accept": {
                  "from_node": "multiply1"
                },
                "reject": {
                  "from_node": "multiply2"
                },
                "value": {
                  "from_node": "lte2"
                }
              }
            },
            "multiply4": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "arrayelement1"
                },
                "y": 10
              }
            },
            "multiply5": {
              "process_id": "multiply",
              "arguments": {
                "x": 2.5,
                "y": {
                  "from_node": "divide1"
                }
              }
            },
            "if2": {
              "process_id": "if",
              "arguments": {
                "accept": {
                  "from_node": "multiply4"
                },
                "reject": {
                  "from_node": "multiply5"
                },
                "value": {
                  "from_node": "lte2"
                }
              }
            },
            "multiply6": {
              "process_id": "multiply",
              "arguments": {
                "x": {
                  "from_node": "arrayelement1"
                },
                "y": 50
              }
            },
            "multiply7": {
              "process_id": "multiply",
              "arguments": {
                "x": 2.5,
                "y": {
                  "from_node": "divide1"
                }
              }
            },
            "if3": {
              "process_id": "if",
              "arguments": {
                "accept": {
                  "from_node": "multiply6"
                },
                "reject": {
                  "from_node": "multiply7"
                },
                "value": {
                  "from_node": "lte2"
                }
              }
            },
            "arraycreate1": {
              "process_id": "array_create",
              "arguments": {
                "data": [
                  {
                    "from_node": "if1"
                  },
                  {
                    "from_node": "if2"
                  },
                  {
                    "from_node": "if3"
                  }
                ]
              },
              "result": true
            }
          }
        }
      }
    },
    "saveresult1": {
      "process_id": "save_result",
      "arguments": {
        "data": {
          "from_node": "applydimension1"
        },
        "format": "GTiff",
        "options": {}
      },
      "result": true
    }
  },
  "parameters": [
    {
      "name": "bounding_box",
      "description": "Spatial extent over the flooded area",
      "schema": {
        "type": "object",
        "subtype": "bounding-box"
      },
      "default": {
        "west": 21.70563513130361,
        "south": 39.26831808742622,
        "east": 22.396135163414897,
        "north": 39.590242870406456
      },
      "optional": true
    },
    {
      "name": "time",
      "description": "Window bracketing the flood-event acquisition(s)",
      "schema": {
        "type": "array",
        "subtype": "temporal-interval"
      },
      "default": [
        "2023-09-06",
        "2023-09-11"
      ],
      "optional": true
    },
    {
      "name": "cloud_cover",
      "description": "Maximum scene-level cloud cover for the S2 background image",
      "schema": {
        "type": "number"
      },
      "default": 30,
      "optional": true
    },
    {
      "name": "water_threshold_db",
      "description": "VV backscatter threshold in dB (used as -water_threshold_db) at or below which a pixel is classified as flooded/water. Lower this to detect MORE water, raise it to detect LESS water.",
      "schema": {
        "type": "number"
      },
      "default": 15,
      "optional": true
    },
    {
      "name": "background_gain",
      "description": "Brightness gain applied to the Sentinel-2 true-color background for non-flooded pixels. Increase for a brighter background, decrease if the background is over-exposed.",
      "schema": {
        "type": "number"
      },
      "default": 2.5,
      "optional": true
    }
  ],
  "id": "flood_detection",
  "summary": "Sentinel-1/Sentinel-2 flood visualization using openEO.",
  "description": "Fuses a single-date Sentinel-1 VV backscatter threshold with a Sentinel-2 near-infrared background to visualize flood extent under cloud cover. Flooded/water pixels (VV backscatter at or below -water_threshold_db) are rendered in blue; all other pixels fall back to the scaled Sentinel-2 background. Converted from the Sentinel Hub S1 Flooding Visualisation custom script by William Ray & Maxim Lamare."
}